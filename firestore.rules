rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(chat) {
      return request.auth.uid in chat.get('members', [])
          || request.auth.uid in chat.get('participants', []);
    }

    // Профили: читать могут вошедшие (нужно для поиска по @нику), менять — только свой
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Юзернеймы: занять можно только свободный, освободить — только свой
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Чаты и группы: только участники
    match /chats/{chatId} {
      allow get: if signedIn() && (resource == null || isMember(resource.data));
      allow list: if signedIn() && isMember(resource.data);
      allow create: if signedIn() && isMember(request.resource.data);
      allow update: if signedIn() && isMember(resource.data);
      allow delete: if false;
    }

    // Сообщения: только участники чата, к которому они относятся
    match /messages/{msgId} {
      function chatOf(id) {
        return get(/databases/$(database)/documents/chats/$(id)).data;
      }
      allow read: if signedIn() && isMember(chatOf(resource.data.chatId));
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && isMember(chatOf(request.resource.data.chatId));
      allow update: if signedIn() && isMember(chatOf(resource.data.chatId));
      allow delete: if false;
    }
  }
}
