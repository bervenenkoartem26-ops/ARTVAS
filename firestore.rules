rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(data) {
      return signedIn()
        && data.members is list
        && request.auth.uid in data.members;
    }

    // Пользователи: любой авторизованный пользователь может найти
    // другого пользователя для создания нового чата.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Чаты используют только поле members.
    // Это важно для Firestore queries: запрос в index.html содержит
    // where('members', 'array-contains', currentUser.uid), поэтому
    // правило чтения должно соответствовать именно этому условию.
    match /chats/{chatId} {
      allow read: if isChatMember(resource.data);

      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;

      allow update: if isChatMember(resource.data)
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;

      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if signedIn()
        && resource.data.chatId is string
        && isChatMember(
          get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data
        );

      allow create: if signedIn()
        && request.resource.data.chatId is string
        && isChatMember(
          get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data
        )
        && request.resource.data.senderId == request.auth.uid;

      allow update: if signedIn()
        && request.auth.uid == resource.data.senderId;

      allow delete: if false;
    }
  }
}
